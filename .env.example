# Generate a long random value. Never commit the real value.
YONAGUNI_SECRET_KEY=replace-with-a-long-random-value
YONAGUNI_DATABASE=/absolute/path/to/database/yonaguni_v2.db
YONAGUNI_MEDIA_ROOT=/absolute/path/to/persistent/media
YONAGUNI_BACKUP_ROOT=/absolute/path/to/persistent/backups
YONAGUNI_HTTPS=1
YONAGUNI_TRUSTED_HOSTS=dictionary.example.org
